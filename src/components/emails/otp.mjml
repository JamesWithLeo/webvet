<mjml>
    <mj-head>
        <mj-title>Login Verification - Joseph and Mary Vet Clinic</mj-title>
        <mj-font
            name="Baskervill Village SC"
            href="https://fonts.googleapis.com/css2?family=Baskervill+Village+SC&display=swap"
        />
        <mj-font
            name="Inter"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700"
        />

        <mj-attributes>
            <mj-all font-family="Inter, Arial, sans-serif" color="#334155" />
            <mj-text padding="0px" />
        </mj-attributes>
    </mj-head>
    <mj-body background-color="#f8fafc">
        <mj-section padding-top="30px" padding-bottom="20px">
            <mj-column width="100%">
                <mj-image
                    src="https://www.josephmary.me/logo.png"
                    width="45px"
                    height="45px"
                    alt="Clinic Logo"
                    align="center"
                />
                <mj-text
                    align="center"
                    font-size="22px"
                    font-family="'Baskervill Village SC', serif"
                    color="rgb(71, 163, 216)"
                    padding-top="10px"
                >
                    Joseph and Mary Vet Clinic
                </mj-text>
                <mj-text
                    align="center"
                    font-size="11px"
                    color="#64748b"
                    padding-top="4px"
                >
                    Pililla, Rizal | +63 9XX XXX XXXX
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section
            background-color="#ffffff"
            border-radius="12px"
            padding="30px 20px"
            border="1px solid #e2e8f0"
        >
            <mj-column>
                <mj-text
                    font-size="16px"
                    font-weight="700"
                    padding-bottom="8px"
                    align="center"
                    color="#0f172a"
                >
                    Verify your email
                </mj-text>
                <mj-text
                    font-size="13px"
                    line-height="1.5"
                    align="center"
                    color="#64748b"
                >
                    Use this code to complete your login. It expires in 5
                    minutes.
                </mj-text>

                <mj-section padding="25px 10px">
                    <mj-column
                        background-color="rgba(71, 163, 216, 0.05)"
                        border-radius="8px"
                        padding="15px"
                        border="1px solid rgb(71, 163, 216)"
                    >
                        <mj-text
                            align="center"
                            font-size="28px"
                            font-weight="700"
                            letter-spacing="6px"
                            color="rgb(71, 163, 216)"
                        >
                            {{ otpCode }}
                        </mj-text>
                    </mj-column>
                </mj-section>

                <mj-text font-size="11px" align="center" color="#94a3b8">
                    If you did not request this, you can safely ignore this
                    email.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding-top="30px" padding-bottom="30px">
            <mj-column width="100%">
                <mj-text
                    align="center"
                    font-size="10px"
                    color="#94a3b8"
                    line-height="16px"
                    padding="0 20px"
                >
                    © 2026 Education Purposes Only. This is a non-affiliated
                    academic capstone project for Joseph and Mary Veterinary
                    Clinic.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
