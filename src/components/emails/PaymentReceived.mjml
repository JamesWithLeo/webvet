<mjml>
    <mj-head>
        <mj-title>Receipt - Joseph and Mary Vet Clinic</mj-title>
        <mj-font
            name="Baskervill Village SC"
            href="https://fonts.googleapis.com/css2?family=Baskervill+Village+SC&display=swap"
        />
        <mj-font
            name="Inter"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700"
        />

        <mj-attributes>
            <mj-all font-family="Inter, Arial, sans-serif" color="#334155" />
            <mj-text padding="0px" />
            <mj-section padding="20px" />
        </mj-attributes>
    </mj-head>
    <mj-body background-color="#f1f5f9">
        <mj-section padding-top="30px" padding-bottom="20px">
            <mj-column width="100%">
                <mj-image
                    src="https://www.josephmary.me/logo.png"
                    width="45px"
                    height="45px"
                    alt="Clinic Logo"
                    align="center"
                />
                <mj-text
                    align="center"
                    font-size="22px"
                    font-family="'Baskervill Village SC', serif"
                    color="rgb(71, 163, 216)"
                    padding-top="10px"
                >
                    Joseph and Mary Vet Clinic
                </mj-text>
                <mj-text
                    align="center"
                    font-size="11px"
                    color="#64748b"
                    padding-top="4px"
                >
                    Pililla, Rizal | +63 9XX XXX XXXX
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section
            background-color="#ffffff"
            border="1px solid #e2e8f0"
            border-radius="12px"
            padding="30px 20px"
        >
            <mj-column width="100%">
                <mj-text font-size="15px" padding-bottom="8px"
                    >Hi {{ ownerName }},</mj-text
                >
                <mj-text
                    font-size="13px"
                    line-height="1.5"
                    padding-bottom="25px"
                >
                    We’ve processed the payment for your visit today. Thank you
                    for choosing us!
                </mj-text>
            </mj-column>

            <mj-column
                width="100%"
                background-color="#f8fafc"
                border-radius="8px"
                padding="15px"
                border="1px solid #e2e8f0"
            >
                {{#each pets}}
                <mj-text
                    font-weight="700"
                    font-size="13px"
                    color="rgb(71, 163, 216)"
                    padding-top="10px"
                    text-transform="uppercase"
                    letter-spacing="1px"
                >
                    🐾 {{ this.petName }}
                </mj-text>

                <mj-table font-size="13px" padding-bottom="10px">
                    {{#each this.services}}
                    <tr>
                        <td
                            style="
                                padding: 8px 0;
                                border-bottom: 1px solid #e2e8f0;
                                width: 70%;
                            "
                        >
                            {{ this.name }}
                        </td>
                        <td
                            style="
                                text-align: right;
                                padding: 8px 0;
                                border-bottom: 1px solid #e2e8f0;
                                width: 30%;
                                font-weight: 600;
                            "
                        >
                            ₱{{ this.price }}
                        </td>
                    </tr>
                    {{/each}}
                </mj-table>
                {{/each}}

                <mj-table padding-top="10px">
                    <tr>
                        <td
                            style="
                                font-size: 13px;
                                color: #64748b;
                                font-weight: 600;
                            "
                        >
                            Total Paid ({{ paymentMethod }})
                        </td>
                        <td
                            style="
                                text-align: right;
                                font-size: 18px;
                                font-weight: 700;
                                color: rgb(71, 163, 216);
                            "
                        >
                            ₱{{ totalAmount }}
                        </td>
                    </tr>
                </mj-table>
            </mj-column>

            <mj-column width="100%">
                <mj-spacer height="25px" />
                <mj-text
                    font-size="11px"
                    color="#94a3b8"
                    padding-bottom="15px"
                    align="center"
                >
                    Transaction ID: {{ transactionId }} | Date: {{ date }}
                </mj-text>

                <mj-button
                    background-color="rgb(71, 163, 216)"
                    color="#ffffff"
                    font-size="15px"
                    font-weight="700"
                    border-radius="8px"
                    href="{{receiptUrl}}"
                    width="100%"
                    inner-padding="14px"
                >
                    Download PDF Receipt
                </mj-button>
            </mj-column>
        </mj-section>

        <mj-section padding-top="30px" padding-bottom="30px">
            <mj-column width="100%">
                <mj-text
                    align="center"
                    font-size="10px"
                    color="#94a3b8"
                    line-height="16px"
                >
                    © 2026 Education Purposes Only. This is a non-affiliated
                    academic capstone project for Joseph and Mary Veterinary
                    Clinic.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
