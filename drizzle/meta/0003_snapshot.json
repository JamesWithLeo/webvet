        "age_check": {
          "name": "age_check",
          "value": "\"pets\".\"age\" >= 0 AND \"pets\".\"age\" <= 100"
        },
        "valid_reproductive_status": {
          "name": "valid_reproductive_status",
          "value": "(\"pets\".\"reproductive_status\" != 'SPAYED' OR \"pets\".\"gender\" = 'female')\n            AND (\"pets\".\"reproductive_status\" != 'NEUTERED' OR \"pets\".\"gender\" = 'male')"
        },
        "ownership_consistency": {
          "name": "ownership_consistency",
          "value": "(\"pets\".\"owner_id\" IS NOT NULL AND \"pets\".\"ownership_status\" = 'OWNED') \n            OR (\"pets\".\"owner_id\" IS NULL AND \"pets\".\"ownership_status\" != 'OWNED')"
        }
